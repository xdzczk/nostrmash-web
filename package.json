{
  "name": "nostrmash-web",
  "version": "0.1.0",
  "private": true,
  "description": "Public explorer for NostrMash. Search notes and profiles, and browse trends, relays, and network stats.",
  "author": "NostrMash",
  "license": "Unlicense",
  "homepage": "https://nostrmash.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/xdzczk/nostrmash-web.git"
  },
  "bugs": {
    "url": "https://github.com/xdzczk/nostrmash-web/issues"
  },
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "prepare": "husky",
    "lint": "eslint --cache --cache-location ./.next/cache/eslint .",
    "lint:fix": "eslint --cache --cache-location ./.next/cache/eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "precheck": "pnpm lint && pnpm typecheck",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "wrangler dev",
    "cf:deploy": "wrangler deploy --keep-vars",
    "cf:typegen": "wrangler types",
    "prod:validate": "node scripts/prod-validate.mjs",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "generate:api-types": "openapi-typescript ../nostrmash/docs/openapi.yaml -o lib/types/generated/api.d.ts"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.11.0",
    "hls.js": "^1.7.4",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --cache --cache-location ./.next/cache/eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "@apm-js-collab/code-transformer": "link:./stubs/packages/code-transformer",
      "@apm-js-collab/code-transformer-bundler-plugins": "link:./stubs/packages/code-transformer-bundler-plugins",
      "@apm-js-collab/tracing-hooks": "link:./stubs/packages/tracing-hooks"
    }
  }
}
